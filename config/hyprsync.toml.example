# HyprSync Configuration
# Copy this file to ~/.config/hypr/hyprsync.toml and customize

[general]
# Unique name for this machine
hostname = "laptop"

# Sync mode: "push", "pull", or "bidirectional"
mode = "bidirectional"

# Conflict resolution: "newest_wins", "manual", or "keep_both"
conflict_strategy = "newest_wins"

# How often to check for remote changes in seconds (0 = local inotify only)
# In bidirectional/pull mode the daemon uses this to poll remotes for changes
poll_interval = 300

# Enable dry-run by default (show what would sync without doing it)
dry_run = false

# Log level: "debug", "info", "warn", "error"
log_level = "info"

[git]
# Local git repository for tracking file versions
repo = "~/.local/share/hyprsync"

# Auto-commit changes before syncing
auto_commit = true

# Commit message template ($hostname is available)
commit_template = "hyprsync: update from $hostname"

[ssh]
# Path to SSH private key (used for all connections)
key = "~/.ssh/id_ed25519"

# Default SSH port
port = 22

# Connection timeout in seconds
timeout = 10

# Reuse SSH connections across rsync calls (much faster for frequent syncs)
multiplex = true

# ── Devices ──────────────────────────────────────────────

[[device]]
name = "desktop"
host = "192.168.1.100"
user = "r2unit"
port = 22
# Optional: override SSH key for this device
# key = "~/.ssh/id_desktop"

[[device]]
name = "server"
host = "homelab.local"
user = "r2unit"
port = 2222

# ── Sync Paths ──────────────────────────────────────────

[[sync]]
name = "hyprland"
paths = [
    "~/.config/hypr/",
    "~/.config/waybar/",
    "~/.config/dunst/",
    "~/.config/mako/",
    "~/.config/hyprlock/",
    "~/.config/hypridle/",
    "~/.config/hyprpaper/",
    "~/.config/wlogout/",
    "~/.config/swaylock/",
    "~/.config/swayidle/",
]
exclude = [
    "*.log",
    "*.bak",
]
# Which devices to sync this group with (empty = all devices)
devices = []

[[sync]]
name = "theming"
# GTK, fonts, Qt — keeps both machines visually identical
paths = [
    "~/.config/gtk-3.0/",
    "~/.config/gtk-4.0/",
    "~/.config/fontconfig/",
    "~/.config/Kvantum/",
    "~/.config/qt5ct/",
    "~/.config/qt6ct/",
    "~/.config/nwg-look/",
    "~/.gtkrc-2.0",
]
devices = []

[[sync]]
name = "shell"
paths = [
    "~/.zshrc",
    "~/.zshenv",
    "~/.config/zsh/",
    "~/.config/starship.toml",
    "~/.config/fish/",
]
devices = []

[[sync]]
name = "editor"
paths = [
    "~/.config/nvim/",
    "~/.config/kitty/",
    "~/.config/foot/",
    "~/.config/alacritty/",
    "~/.gitconfig",
    "~/.tmux.conf",
]
devices = []

[[sync]]
name = "scripts"
paths = [
    "~/.local/bin/",
]
exclude = [
    "__pycache__/",
    "*.pyc",
]
# Only sync to specific devices
devices = ["desktop"]

# ── Hooks ────────────────────────────────────────────────

[hooks]
pre_sync = ""
post_sync = ""

[hooks.group]
hyprland = "hyprctl reload"
